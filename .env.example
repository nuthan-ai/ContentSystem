# Copy to .env and fill in
OPENROUTER_API_KEY=
# Default model (changeable in Settings UI)
OPENROUTER_MODEL=google/gemini-2.0-flash-001
# Optional: GitHub token raises API rate limits (public data only)
GITHUB_TOKEN=
# Max items sent to the LLM per run (cost guard)
LLM_ITEM_CAP=60
# X/Twitter collector: dedicated secondary account (never your primary — this
# violates X's ToS on automation and the account can get locked/suspended).
# Run `backend/login_twitter.py` once after setting these to save a session;
# the collector then reuses the saved cookies and these fields are no longer read.
TWITTER_USERNAME=
TWITTER_EMAIL=
TWITTER_PASSWORD=
